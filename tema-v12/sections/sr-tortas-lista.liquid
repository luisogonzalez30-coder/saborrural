{%- liquid
  assign wa = section.settings.whatsapp
  assign foto = section.settings.foto | default: 'sr-encargo-corazon.jpg'
  assign fu = foto | file_url
  if fu contains '?'
    assign hero_src = fu | append: '&width=1000'
  else
    assign hero_src = fu | append: '?width=1000'
  endif
-%}
<div class="sr tl" id="tl" data-wa="{{ wa }}">
<style>
.tl{--pk:#F07C95;--pk2:#E2587C;--ln:rgba(242,132,151,.28);background:#0C0D0F;color:#F3F1EA;overflow-x:clip}
.tl *{box-sizing:border-box}
.tl .tl-w{max-width:1120px;margin:0 auto;padding:0 max(16px,env(safe-area-inset-left,0px))}
.tl h1,.tl h2,.tl h3{font-family:var(--font-display);margin:0;color:#fff}
.tl .tl-hero{position:relative;overflow:hidden;isolation:isolate;background:radial-gradient(80% 90% at 85% 0%,rgba(194,48,72,.42),transparent 68%),#0C0D0F}
.tl .tl-hero-img{position:absolute;top:0;right:0;bottom:0;width:min(52%,560px);z-index:-1;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 38%);mask-image:linear-gradient(90deg,transparent 0,#000 38%)}
.tl .tl-hero-img img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 70%}
.tl .tl-hero-img::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0C0D0F 0%,transparent 14%,transparent 82%,#0C0D0F 100%)}
.tl .tl-hero .tl-w{padding-top:34px;padding-bottom:54px;min-height:480px;display:flex;flex-direction:column;justify-content:center;gap:16px}
.tl .tl-back{align-self:flex-start;color:#E4D6DA;font:700 .92rem/1 var(--font-body);text-decoration:none;opacity:.9}
.tl .tl-back:hover{color:#F59AAC}
.tl .tl-eyebrow{align-self:flex-start;font:700 12.5px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:#1A0A0F;background:linear-gradient(135deg,#F59AAC,#E2587C);padding:8px 14px;border-radius:99px}
.tl h1{font:800 clamp(2.4rem,9vw,4.6rem)/1 var(--font-display);letter-spacing:-.03em;max-width:9em;text-shadow:0 2px 18px rgba(0,0,0,.7)}
.tl h1 em{font-family:var(--font-chalk);font-style:normal;font-weight:700;color:#F59AAC;font-size:1.2em;letter-spacing:0}
.tl .tl-lead{max-width:30em;color:#F3F1EA;font-size:clamp(1rem,2.9vw,1.15rem);line-height:1.5;text-shadow:0 2px 14px rgba(0,0,0,.8)}
.tl .tl-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.tl .tl-chips li{padding:9px 14px;border:1px solid var(--ln);border-radius:99px;background:rgba(10,8,10,.6);color:#F3F1EA;font:600 .9rem/1 var(--font-body)}
.tl .tl-main{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.9fr);gap:28px;align-items:start;padding:34px 0 40px}
.tl .tl-step{margin-bottom:34px}
.tl .tl-step>h2{display:flex;align-items:center;gap:12px;font:800 clamp(1.4rem,4.4vw,1.9rem)/1.1 var(--font-display);letter-spacing:-.015em}
.tl .tl-step>h2 b{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#F59AAC,#E2587C);color:#1A0A0F;font:800 1.05rem/1 var(--font-display)}
.tl .tl-sub{margin:8px 0 14px;color:#C9CBC2;font-size:.98rem}
.tl .tl-sizes{display:flex;flex-wrap:wrap;gap:10px}
.tl .tl-sz{min-height:52px;padding:0 20px;border-radius:14px;border:1.5px solid rgba(255,255,255,.22);background:rgba(21,23,27,.9);color:#F3F1EA;font:700 1.02rem/1 var(--font-body);cursor:pointer}
.tl .tl-sz small{display:block;margin-top:3px;font:600 .72rem/1 var(--font-body);opacity:.75}
.tl .tl-sz[aria-pressed="true"]{background:linear-gradient(135deg,#F7A9B8,#E2587C);border-color:transparent;color:#1A0A0F}
.tl .tl-note{margin:12px 0 0;padding:12px 14px;border-left:4px solid var(--pk);background:#15171B;border-radius:6px;color:#E4D6DA;font-size:.95rem}
.tl .tl-note[hidden]{display:none}
.tl .tl-tools{display:grid;gap:12px;margin-bottom:14px}
.tl .tl-search{width:100%;min-height:50px;padding:0 16px;border-radius:14px;border:1.5px solid #34373E;background:#0C0D0F;color:#F3F1EA;font:500 16px var(--font-body)}
.tl .tl-search::placeholder{color:#6F727A}
.tl .tl-fl{display:flex;flex-wrap:wrap;gap:8px}
.tl .tl-f{min-height:42px;padding:0 15px;border-radius:99px;border:1.5px solid rgba(255,255,255,.25);background:transparent;color:#F3F1EA;font:600 .9rem/1 var(--font-body);cursor:pointer}
.tl .tl-f[aria-pressed="true"]{background:#F3F1EA;color:#0C0D0F;border-color:#F3F1EA}
.tl .tl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:12px}
.tl .tl-card{position:relative;display:grid;gap:8px;align-content:space-between;min-height:116px;padding:15px 14px 14px;text-align:left;border-radius:16px;border:1.5px solid #2A2D33;background:#15171B;color:#F3F1EA;cursor:pointer;font-family:var(--font-body)}
.tl .tl-card:hover{border-color:rgba(242,132,151,.6)}
.tl .tl-card b{font:800 1.08rem/1.15 var(--font-display);color:#fff}
.tl .tl-card span{font:800 1.35rem/1 var(--font-display);color:#F8B7C4;font-variant-numeric:tabular-nums}
.tl .tl-card small{font:600 .74rem/1 var(--font-body);color:#A9ABA3}
.tl .tl-card[aria-pressed="true"]{border-color:#F59AAC;background:linear-gradient(160deg,#3A1620,#150B0F 75%);box-shadow:0 0 0 1px rgba(245,154,172,.5)}
.tl .tl-card[aria-pressed="true"]::after{content:"✓";position:absolute;top:10px;right:12px;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#F59AAC;color:#1A0A0F;font:800 14px/1 var(--font-body)}
.tl .tl-empty{padding:18px;border:1px dashed #3A3D44;border-radius:14px;color:#C9CBC2;text-align:center}
.tl .tl-empty[hidden]{display:none}
.tl .tl-form{display:grid;gap:14px}
.tl .tl-two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.tl .tl-fld{display:grid;gap:6px;min-width:0;align-content:start}
.tl .tl-fld label{font:700 .88rem/1.2 var(--font-body);color:#E4D6DA}
.tl .tl-fld input,.tl .tl-fld select,.tl .tl-fld textarea{width:100%;min-height:50px;padding:10px 14px;border-radius:12px;border:1.5px solid #34373E;background:#0C0D0F;color:#F3F1EA;font:500 16px var(--font-body)}
.tl .tl-fld textarea{min-height:104px;resize:vertical}
.tl .tl-fld input::placeholder,.tl .tl-fld textarea::placeholder{color:#6F727A}
.tl .tl-fld .tl-help{font-size:.82rem;color:#A9ABA3}
.tl .tl-sum{position:sticky;top:16px;display:grid;gap:14px;padding:22px 20px;border:1px solid rgba(242,132,151,.45);border-radius:22px;background:radial-gradient(90% 70% at 100% 0%,rgba(194,48,72,.4),transparent 66%),linear-gradient(165deg,#2A1119,#120A0E 75%)}
.tl .tl-sum h2{font:800 1.5rem/1.1 var(--font-display)}
.tl .tl-rows{display:grid;gap:8px;margin:0;padding:0;list-style:none}
.tl .tl-rows li{display:flex;justify-content:space-between;gap:12px;font-size:.98rem;color:#E4D6DA}
.tl .tl-rows li b{color:#fff;text-align:right}
.tl .tl-total{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.14)}
.tl .tl-total span{color:#C9CBC2;font-size:.92rem}
.tl .tl-total strong{font:800 2rem/1 var(--font-display);color:#fff;font-variant-numeric:tabular-nums}
.tl .tl-msg{padding:12px 14px;border:1.5px dashed #3A3D44;border-radius:12px;background:#0C0D0F;color:#B6B8B0;font-size:.86rem;white-space:pre-wrap;overflow-wrap:anywhere;max-height:200px;overflow:auto}
.tl .tl-msg b{display:block;margin-bottom:6px;font:700 .72rem/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:#F28497}
.tl .tl-go{display:flex;align-items:center;justify-content:center;gap:10px;min-height:60px;border-radius:16px;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;font:800 1.15rem/1 var(--font-display);text-decoration:none;box-shadow:0 16px 30px -14px rgba(226,88,124,.9)}
.tl .tl-go:hover{filter:brightness(1.07)}
.tl button.tl-go{width:100%;border:0;cursor:pointer}
.tl button.tl-go:disabled{cursor:not-allowed;filter:grayscale(.55) brightness(.8)}
.tl .tl-wa{display:block;text-align:center;color:#F3F1EA;font:700 .92rem/1.2 var(--font-body);text-decoration:underline;text-decoration-color:rgba(245,154,172,.6);text-underline-offset:4px}
.tl .tl-why{margin:0;color:#F8B7C4;font:600 .86rem/1.35 var(--font-body);text-align:center}
.tl .tl-why:empty{display:none}
.tl .tl-lbl{font:700 .88rem/1.2 var(--font-body);color:#E4D6DA}
.tl .tl-fine{margin:0;color:#A9ABA3;font-size:.82rem;text-align:center}
.tl .tl-insp{padding:10px 0 50px}
.tl .tl-insp h2{font:800 clamp(1.5rem,4.6vw,2rem)/1.1 var(--font-display);margin-bottom:14px}
.tl .tl-ph{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.tl .tl-ph figure{margin:0;border-radius:14px;overflow:hidden;background:#15171B}
.tl .tl-ph img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
.tl .tl-info{margin:0 0 46px;padding:18px;border:1px solid var(--ln);border-radius:18px;background:rgba(16,9,13,.9);text-align:center;color:#E4D6DA;font:500 .98rem/1.5 var(--font-body)}
.tl .tl-info b{color:#fff}
.tl .tl-esp{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px 14px;align-items:center;max-width:540px;margin-top:6px;padding:16px 16px 16px;border-radius:22px;border:1.5px solid rgba(245,154,172,.7);background:linear-gradient(160deg,rgba(58,22,32,.92),rgba(18,10,14,.92));box-shadow:0 0 0 4px rgba(240,124,149,.12),0 24px 50px -26px rgba(226,88,124,.8)}
.tl .tl-esp-ico{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F}
.tl .tl-esp-ico svg{width:26px;height:26px}
.tl .tl-esp-t{margin:0;display:grid;gap:3px}
.tl .tl-esp-t b{font:800 clamp(1.05rem,3.6vw,1.3rem)/1.15 var(--font-display);color:#fff}
.tl .tl-esp-t span{font:500 .92rem/1.35 var(--font-body);color:#E4D6DA}
.tl .tl-esp-go{grid-column:1/-1;position:relative;display:flex;align-items:center;justify-content:center;gap:10px;min-height:58px;border-radius:16px;background:linear-gradient(135deg,#34D27A,#1FAF5B);color:#04190D;font:800 1.12rem/1 var(--font-display);text-decoration:none;box-shadow:0 16px 30px -14px rgba(31,175,91,.95)}
.tl .tl-esp-go svg{width:26px;height:26px}
.tl .tl-esp-go::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid #7CF0AB;opacity:0;pointer-events:none}
.tl.live .tl-esp-go::after{animation:tl-ring 2.2s ease-out infinite}
.tl .tl-esp-go:hover{filter:brightness(1.06)}
@keyframes tl-ring{0%{transform:scale(1);opacity:.8}100%{transform:scale(1.07,1.32);opacity:0}}
.tl .tl-esp-2{margin:0;text-align:center;font-size:.86rem;color:#E4D6DA}
.tl .tl-esp-2 a{color:#7CF0AB;font-weight:700}
@media (prefers-reduced-motion:reduce){.tl.live .tl-esp-go::after{animation:none}}
.tl .tl-help-pk{color:#F8B7C4;font-weight:600}
.tl .tl-ent{display:grid;gap:10px}
.tl .tl-opt{display:grid;gap:4px;text-align:left;padding:14px 16px 14px 52px;position:relative;border-radius:14px;border:1.5px solid #34373E;background:#15171B;color:#F3F1EA;cursor:pointer;font-family:var(--font-body)}
.tl .tl-opt b{font:800 1.08rem/1.15 var(--font-display);color:#fff}
.tl .tl-opt small{font:500 .86rem/1.3 var(--font-body);color:#C9CBC2}
.tl .tl-opt::before{content:"";position:absolute;left:16px;top:50%;width:22px;height:22px;margin-top:-11px;border-radius:50%;border:2px solid #6F727A}
.tl .tl-opt[aria-checked="true"]{border-color:#F59AAC;background:linear-gradient(160deg,#3A1620,#150B0F 75%)}
.tl .tl-opt[aria-checked="true"]::before{border-color:#F59AAC;background:radial-gradient(circle,#F59AAC 0 45%,transparent 50%)}
.tl .tl-zona{display:grid;gap:6px;margin-top:6px}
.tl .tl-zona[hidden]{display:none}
.tl .tl-zona label{font:700 .88rem/1.2 var(--font-body);color:#E4D6DA}
.tl .tl-zona select{width:100%;min-height:50px;padding:10px 14px;border-radius:12px;border:1.5px solid #34373E;background:#0C0D0F;color:#F3F1EA;font:500 16px var(--font-body)}
.tl .tl-write{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px 14px;align-items:center;padding:18px 16px;border-radius:20px;border:1.5px solid rgba(245,154,172,.75);background:radial-gradient(90% 120% at 100% 0%,rgba(226,88,124,.35),transparent 66%),linear-gradient(160deg,#3A1620,#150B0F 80%);box-shadow:0 0 0 4px rgba(240,124,149,.12),0 22px 44px -26px rgba(226,88,124,.85)}
.tl .tl-write-ico{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F}
.tl .tl-write-ico svg{width:24px;height:24px}
.tl .tl-write-t{display:grid;gap:3px}
.tl .tl-write-t b{font:800 clamp(1.05rem,3.6vw,1.3rem)/1.15 var(--font-display);color:#fff}
.tl .tl-write-t span{font:500 .92rem/1.35 var(--font-body);color:#F3E4E8}
.tl .tl-write-t em{font-family:var(--font-chalk);font-style:normal;font-weight:700;font-size:1.2em;color:#F8B7C4}
.tl .tl-write-in{grid-column:1/-1;width:100%;min-height:58px;padding:0 16px;border-radius:14px;border:2px solid #F59AAC;background:#0C0D0F;color:#fff;font:600 1.1rem var(--font-body)}
.tl .tl-write-in::placeholder{color:#8A8D94;font-weight:500}
.tl .tl-card.on{grid-column:1/-1;min-height:0}
.tl .tl-det{display:grid;gap:6px;padding-top:10px;margin-top:2px;border-top:1px solid rgba(255,255,255,.14);cursor:default}
.tl .tl-det i{font:700 .72rem/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:#F28497;font-style:normal}
.tl .tl-det p{margin:0;font:500 .98rem/1.45 var(--font-body);color:#F3F1EA}
.tl .tl-det a{justify-self:start;margin-top:2px;color:#7CF0AB;font:700 .9rem/1.2 var(--font-body)}
@media (max-width:760px){.tl .tl-main{grid-template-columns:1fr}.tl .tl-sum{position:static}.tl .tl-hero-img{width:100%;opacity:.45;-webkit-mask-image:none;mask-image:none}.tl .tl-ph{grid-template-columns:repeat(2,1fr)}.tl .tl-two{grid-template-columns:1fr}}

.tl .tl-how{background:linear-gradient(180deg,#0C0D0F 0%,#150a0e 55%,#0C0D0F 100%);border-top:1px solid var(--ln);border-bottom:1px solid rgba(255,255,255,.06)}
.tl .tl-how .tl-w{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:36px;align-items:center;padding-top:40px;padding-bottom:44px}
.tl .tl-how-eb{display:inline-block;font:700 12.5px/1 var(--font-body);letter-spacing:.16em;text-transform:uppercase;color:var(--pk)}
.tl .tl-how h2{margin:10px 0 0;font:800 clamp(1.8rem,5.6vw,2.6rem)/1.05 var(--font-display);letter-spacing:-.02em}
.tl .tl-how h2 em{font-style:normal;color:#F59AAC}
.tl .tl-how-p{margin:12px 0 0;color:#D9D7CE;font-size:1.02rem;line-height:1.5;max-width:30em}
.tl .tl-how-s{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:10px}
.tl .tl-how-s li{display:flex;align-items:center;gap:12px;font:700 1rem/1.25 var(--font-body);color:#F3F1EA}
.tl .tl-how-s b{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#F59AAC,#E2587C);color:#1A0A0F;font:800 .92rem/1 var(--font-display)}
.tl .tl-how-go{display:inline-flex;align-items:center;gap:8px;margin-top:22px;min-height:50px;padding:0 24px;border-radius:14px;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;font:800 1rem/1 var(--font-body);text-decoration:none;box-shadow:0 10px 26px rgba(226,88,124,.32)}
.tl .tl-vid{position:relative;aspect-ratio:16/9;border-radius:22px;overflow:hidden;border:1px solid var(--ln);background:#0C0D0F;box-shadow:0 18px 50px rgba(194,48,72,.28);cursor:pointer;-webkit-tap-highlight-color:transparent}
.tl .tl-vid picture,.tl .tl-vid img,.tl .tl-vid video{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover}
.tl .tl-vid video{opacity:0;transition:opacity .5s ease}
.tl .tl-vid video.on{opacity:1}
.tl .tl-play{position:absolute;left:50%;top:50%;width:72px;height:72px;margin:-36px 0 0 -36px;border:0;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;box-shadow:0 8px 26px rgba(0,0,0,.5);cursor:pointer;transition:opacity .25s}
.tl .tl-play svg{width:30px;height:30px;margin-left:4px}
.tl .tl-vid.is-on .tl-play{opacity:0;pointer-events:none}
.tl .tl-snd{position:absolute;right:12px;bottom:12px;min-height:40px;padding:0 14px;border:1px solid rgba(255,255,255,.4);border-radius:99px;background:rgba(12,13,15,.8);color:#fff;font:700 .86rem/1 var(--font-body);cursor:pointer}
.tl .tl-snd[hidden]{display:none}
@media (max-width:760px){.tl .tl-how .tl-w{grid-template-columns:1fr;gap:24px}.tl .tl-vid{aspect-ratio:9/16;max-width:320px;width:100%;margin:0 auto}.tl .tl-how-go{width:100%;justify-content:center}}
</style>

  <section class="tl-hero" aria-labelledby="tl-h-{{ section.id }}">
    <div class="tl-hero-img" aria-hidden="true"><img src="{{ hero_src }}" alt="" width="1000" height="1250" fetchpriority="high"></div>
    <div class="tl-w">
      <a class="tl-back" href="{{ routes.root_url }}">← Volver al inicio</a>
      <span class="tl-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 id="tl-h-{{ section.id }}">{{ section.settings.titulo_a }} <em>{{ section.settings.titulo_b }}</em></h1>
      <p class="tl-lead">{{ section.settings.bajada }}</p>
      <ul class="tl-chips"><li>28 sabores</li><li>De 15 a 40 personas</li><li>Pagas en línea</li><li>Mínimo 3 días completos</li><li>Retiro gratis</li></ul>
      <div class="tl-esp">
        <span class="tl-esp-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg></span>
        <p class="tl-esp-t"><b>{{ section.settings.esp_titulo }}</b><span>{{ section.settings.esp_texto }}</span></p>
        <a class="tl-esp-go" id="tlEsp" href="https://wa.me/{{ wa }}?text={{ section.settings.esp_mensaje | url_encode }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.5A9.9 9.9 0 1 0 12.04 2zm0 1.8a8.1 8.1 0 1 1-4.2 15l-.3-.2-3.1.9.9-3-.2-.3A8.1 8.1 0 0 1 12.04 3.8zm-3.1 4.3c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.7-.4l-1.8-.9c-.3-.1-.5-.1-.7.1l-.9 1.1c-.1.2-.3.2-.6.1-1.4-.7-2.4-1.3-3.3-2.8-.1-.3 0-.4.2-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5l-.8-2c-.2-.5-.4-.4-.6-.4z"/></svg>
          {{ section.settings.esp_boton }}
        </a>
      </div>
    </div>
  </section>

  <section class="tl-how" aria-labelledby="tl-how-{{ section.id }}">
    <div class="tl-w">
      <div class="tl-how-t">
        <span class="tl-how-eb">Cómo encargar</span>
        <h2 id="tl-how-{{ section.id }}">Tu torta en <em>1 minuto</em></h2>
        <p class="tl-how-p">Mira el paso a paso: eliges para cuántas personas, el sabor, la fecha y el horario, y pagas en línea. Retiras gratis en el local.</p>
        <ol class="tl-how-s"><li><b>1</b>Elige para cuántas personas</li><li><b>2</b>Escoge el sabor y mira el valor</li><li><b>3</b>Fecha, horario y mensaje</li><li><b>4</b>Paga en línea y retira gratis</li></ol>
        <a class="tl-how-go" href="#tl-pasos">Elegir mi torta ↓</a>
      </div>
      <div class="tl-vid" role="group" aria-label="Video: cómo encargar tu torta">
        {%- assign pm = section.settings.poster_movil | file_url -%}{%- assign pd = section.settings.poster_escritorio | file_url -%}
        <picture><source media="(min-width:761px)" srcset="{{ pd }}"><img src="{{ pm }}" alt="Video: cómo encargar tu torta en Sabor Rural" width="540" height="960" loading="lazy" decoding="async"></picture>
        <video muted loop playsinline preload="none" data-m="{{ section.settings.video_movil | file_url }}" data-d="{{ section.settings.video_escritorio | file_url }}"></video>
        <button type="button" class="tl-play" aria-label="Reproducir video"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg></button>
        <button type="button" class="tl-snd"{% unless section.settings.con_audio %} hidden{% endunless %}>Activar sonido</button>
      </div>
    </div>
  </section>

  <div class="tl-w" id="tl-pasos">
    <div class="tl-main">
      <div>
        <div class="tl-step">
          <h2><b>1</b>¿Para cuántas personas?</h2>
          <p class="tl-sub">El valor cambia según el tamaño.</p>
          <div class="tl-sizes" id="tlSizes" role="group" aria-label="Cantidad de personas"></div>
          <p class="tl-note" id="tlBig" hidden>Para más de 40 personas armamos la torta a tu medida: te atendemos de forma personalizada por WhatsApp.</p>
        </div>

        <div class="tl-step">
          <h2><b>2</b>Elige tu torta</h2>
          <p class="tl-sub">Cada sabor muestra su valor para el tamaño que elegiste.</p>
          <div class="tl-tools">
            <input class="tl-search" id="tlQ" type="search" placeholder="Buscar sabor: chocolate, manjar, frutilla…" autocomplete="off" aria-label="Buscar sabor">
            <div class="tl-fl" id="tlFl" role="group" aria-label="Filtrar por tipo"></div>
          </div>
          <div class="tl-grid" id="tlGrid"></div>
          <p class="tl-empty" id="tlNo" hidden>No encontramos ese sabor. Prueba con otra palabra o cuéntanos tu idea abajo.</p>
        </div>

        <div class="tl-step">
          <h2><b>3</b>Cuéntanos cómo la quieres</h2>
          <p class="tl-sub">Fecha, horario de retiro y el mensaje que quieres en tu torta.</p>
          <div class="tl-form">
            <div class="tl-two">
              <div class="tl-fld"><label for="tlOc">Ocasión</label>
                <select id="tlOc"><option>Cumpleaños</option><option>Aniversario</option><option>Bautizo o comunión</option><option>Matrimonio</option><option>Otra ocasión</option></select></div>
              <div class="tl-fld"><label for="tlFe">Fecha que la necesitas</label><input id="tlFe" type="date">
                <span class="tl-help tl-help-pk" id="tlFeH">Mínimo 3 días completos de anticipación.</span></div>
            </div>

            <div class="tl-two">
              <div class="tl-fld"><span class="tl-lbl">Entrega</span>
                <div class="tl-opt" aria-checked="true" style="cursor:default"><b>Retiro gratis en el local</b><small>Ruta J-60, km 95, Sector Lora, Licantén</small></div></div>
              <div class="tl-fld"><label for="tlHr">Horario de retiro</label>
                <select id="tlHr"></select>
                <span class="tl-help">Lunes a viernes de 9:00 a 21:00 · Sábado y domingo de 14:00 a 21:00.</span></div>
            </div>

            <div class="tl-write">
              <span class="tl-write-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span>
              <div class="tl-write-t"><b>¿Quieres que tu torta lleve algo escrito arriba?</b><span>Déjanos aquí tu mensaje: <em>Feliz cumpleaños Sofía</em>, un nombre, una fecha…</span></div>
              <input id="tlMs" class="tl-write-in" type="text" maxlength="60" placeholder="Escribe aquí el mensaje de tu torta" autocomplete="off" aria-label="Mensaje escrito en la torta">
            </div>

            <div class="tl-two">
              <div class="tl-fld"><label for="tlNo2">Tu nombre</label><input id="tlNo2" type="text" placeholder="Cómo te llamas" autocomplete="given-name"></div>
              <div class="tl-fld"><label for="tlId">Comentarios (opcional)</label>
                <textarea id="tlId" placeholder="Ej.: color de la crema, sin nueces"></textarea></div>
            </div>
            <span class="tl-help">Aquí se encargan tortas sin diseño especial. Si quieres diseño, fondant o figuras, <a id="tlEsp3" href="https://wa.me/{{ wa }}?text={{ section.settings.esp_mensaje | url_encode }}" target="_blank" rel="noopener" style="color:#F59AAC;font-weight:700">escríbenos por WhatsApp</a>.</span>
          </div>
        </div>
      </div>

      <aside class="tl-sum" aria-label="Resumen de tu pedido">
        <h2>Tu pedido</h2>
        <ul class="tl-rows">
          <li><span>Torta</span><b id="sTorta">Sin elegir</b></li>
          <li><span>Para</span><b id="sPers">20 personas</b></li>
          <li><span>Retiro</span><b id="sRet">Elige fecha y horario</b></li>
        </ul>
        <div class="tl-total"><span>Total</span><strong id="sTot">—</strong></div>
        <p class="tl-why" id="sWhy"></p>
        <button type="button" class="tl-go" id="sPay">Pagar y agendar</button>
        <a class="tl-wa" id="sGo" href="#" target="_blank" rel="noopener">Prefiero pedir por WhatsApp</a>
        <p class="tl-esp-2">¿Diseño, fondant o algo especial? <a id="tlEsp2" href="https://wa.me/{{ wa }}?text={{ section.settings.esp_mensaje | url_encode }}" target="_blank" rel="noopener">Escríbenos</a></p>
        <p class="tl-fine">Pagas el total en línea con Mercado Pago y retiras gratis en el local. Tortas sin diseño: mínimo 3 días completos de anticipación.</p>
      </aside>
    </div>

    <section class="tl-insp" aria-labelledby="tl-i-{{ section.id }}">
      <h2 id="tl-i-{{ section.id }}">Inspírate con nuestro trabajo</h2>
      <div class="tl-ph">
        {%- assign fotos = 'sr-obra-oreo.jpg,sr-obra-lazo.jpg,sr-obra-lucuma.jpg,sr-obra-guindas.jpg' | split: ',' -%}
        {%- for f in fotos -%}
          {%- assign pu = f | file_url -%}{%- if pu contains '?' -%}{%- assign ps = pu | append: '&width=420' -%}{%- else -%}{%- assign ps = pu | append: '?width=420' -%}{%- endif -%}
          <figure><img src="{{ ps }}" alt="Torta hecha en Sabor Rural" width="420" height="525" loading="lazy" decoding="async"></figure>
        {%- endfor -%}
      </div>
    </section>
    <p class="tl-info"><b>Sabor Rural</b> · Ruta J-60, km 95, Sector Lora, Licantén<br>Lunes a viernes 9:00 – 21:00 · Sábado y domingo 14:00 – 21:00</p>
  </div>

