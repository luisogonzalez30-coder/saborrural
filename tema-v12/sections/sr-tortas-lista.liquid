{%- render 'sr-pagar' -%}
<script>
(function () {
  var root = document.getElementById('tl'); if (!root) return;
  var DATA = JSON.parse(document.getElementById('tlData').textContent);
  var DET = JSON.parse(document.getElementById('tlDet').textContent);
  var SIZES = [15, 20, 25, 30, 35, 40], WA = root.getAttribute('data-wa') || '';
  var FILTERS = [['all', 'Todas'], ['manjar', 'Con manjar'], ['chocolate', 'Chocolate'], ['fruta', 'Frutas'], ['panqueque', 'Panqueque']];
  var KEYS = { manjar: ['manjar'], chocolate: ['chocolate'], fruta: ['durazno', 'piña', 'frambuesa', 'frutilla', 'naranja'], panqueque: ['panqueque'] };
  var st = { n: 20, sel: -1, f: 'all', q: '', e: 'retiro' };
  function $(id) { return document.getElementById(id); }
  function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function clp(n) { return '$' + String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function norm(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
  function fecha(iso) { if (!iso) return 'por definir'; var p = iso.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
  function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
  function idx(n) { return SIZES.indexOf(n); }
  function detalle(row) { return DET[norm(row[0])] || ''; }

  var sizes = $('tlSizes');
  SIZES.concat(['mas']).forEach(function (n) {
    var b = el('button', 'tl-sz'); b.type = 'button'; b.setAttribute('data-n', n);
    b.textContent = n === 'mas' ? 'Más de 40' : n + ' personas';
    b.addEventListener('click', function () { st.n = n; render(); });
    sizes.appendChild(b);
  });
  var fl = $('tlFl');
  FILTERS.forEach(function (f) {
    var b = el('button', 'tl-f', f[1]); b.type = 'button'; b.setAttribute('data-f', f[0]);
    b.addEventListener('click', function () { st.f = f[0]; render(); });
    fl.appendChild(b);
  });
  $('tlQ').addEventListener('input', function () { st.q = norm(this.value.trim()); render(); });
  ['tlOc', 'tlHr', 'tlNo2', 'tlId', 'tlMs'].forEach(function (id) { $(id).addEventListener('input', summary); $(id).addEventListener('change', summary); });
  $('tlFe').addEventListener('change', function () { horarios(); summary(); }); $('tlFe').addEventListener('input', function () { horarios(); summary(); });
  /* tortas sin diseño: mínimo 3 días completos entre el pedido y el retiro (si pides el lunes, retiras desde el viernes) */
  var min = new Date(); min.setDate(min.getDate() + 4); var MIN = iso(min); $('tlFe').min = MIN;
  $('tlFeH').textContent = 'Mínimo 3 días completos de anticipación: la primera fecha disponible es el ' + fecha(MIN) + '.';
  var SEMANA = ['9:00 a 12:00', '12:00 a 15:00', '15:00 a 18:00', '18:00 a 21:00'], FINDE = ['14:00 a 17:00', '17:00 a 21:00'];
  function horarios() {
    var hr = $('tlHr'), v = $('tlFe').value, prev = hr.value; hr.textContent = '';
    if (!v) { hr.appendChild(el('option', null, 'Elige primero la fecha')); hr.options[0].value = ''; hr.disabled = true; return; }
    var p = v.split('-'), dia = new Date(+p[0], +p[1] - 1, +p[2]).getDay(), list = (dia === 0 || dia === 6) ? FINDE : SEMANA;
    hr.disabled = false; hr.appendChild(el('option', null, 'Elige un horario')); hr.options[0].value = '';
    list.forEach(function (h) { var o = el('option', null, h + ' hrs'); o.value = h; hr.appendChild(o); });
    if (list.indexOf(prev) >= 0) hr.value = prev;
  }
  horarios();
  var DESIGN = false;

  function match(row) {
    var name = norm(row[0]);
    if (st.q && name.indexOf(st.q) < 0) return false;
    if (st.f === 'all') return true;
    return KEYS[st.f].some(function (k) { return name.indexOf(norm(k)) >= 0; });
  }
  function render() {
    Array.prototype.forEach.call(sizes.children, function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-n') === String(st.n))); });
    Array.prototype.forEach.call(fl.children, function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-f') === st.f)); });
    $('tlBig').hidden = st.n !== 'mas';
    var grid = $('tlGrid'); grid.textContent = ''; var shown = 0;
    DATA.forEach(function (row, i) {
      if (!match(row)) return; shown++;
      var on = i === st.sel;
      var b = el('div', 'tl-card' + (on ? ' on' : '')); b.setAttribute('role', 'button'); b.tabIndex = 0; b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-expanded', String(on));
      b.appendChild(el('b', null, row[0]));
      b.appendChild(el('span', null, st.n === 'mas' ? 'A medida' : clp(row[1 + idx(st.n)])));
      b.appendChild(el('small', null, st.n === 'mas' ? 'Cotización personalizada' : 'para ' + st.n + ' personas'));
      if (on) {
        var d = el('div', 'tl-det'); d.appendChild(el('i', null, 'Lo que trae'));
        var t = detalle(row);
        if (t) d.appendChild(el('p', null, t));
        else {
          d.appendChild(el('p', null, 'Pregúntanos por el detalle de este sabor y te lo contamos por WhatsApp.'));
          var a = el('a', null, 'Consultar el detalle por WhatsApp'); a.target = '_blank'; a.rel = 'noopener';
          a.href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent('Hola Sabor Rural, quiero saber qué trae la torta ' + row[0] + '.');
          a.addEventListener('click', function (e) { e.stopPropagation(); });
          d.appendChild(a);
        }
        b.appendChild(d);
      }
      var toggle = function () { st.sel = (st.sel === i ? -1 : i); render(); };
      b.addEventListener('click', toggle);
      b.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
      grid.appendChild(b);
    });
    $('tlNo').hidden = shown > 0;
    summary();
  }
  function summary() {
    var row = st.sel >= 0 ? DATA[st.sel] : null, big = st.n === 'mas';
    var price = row && !big ? row[1 + idx(st.n)] : null, det = row ? detalle(row) : '';
    var vid = row && !big && row[7] ? row[7][idx(st.n)] : null;
    var fe = $('tlFe').value, hr = $('tlHr').value, fechaOk = !!fe && fe >= MIN;
    $('sTorta').textContent = row ? row[0] : 'Sin elegir';
    $('sPers').textContent = big ? 'Más de 40 personas' : st.n + ' personas';
    $('sRet').textContent = fechaOk && hr ? fecha(fe) + ', ' + hr + ' hrs' : 'Elige fecha y horario';
    $('sTot').textContent = big ? 'A medida' : (price ? clp(price) : '—');
    var nom = $('tlNo2').value.trim() || '[tu nombre]', idea = $('tlId').value.trim(), msj = $('tlMs').value.trim();
    var t = 'Hola Sabor Rural, soy ' + nom + '. Quiero encargar una torta:' +
      '\n• Torta: ' + (row ? row[0] : 'por definir') +
      (det ? '\n• Lleva: ' + det : '') +
      '\n• Para: ' + (big ? 'más de 40 personas (necesito cotización personalizada)' : st.n + ' personas') +
      (price ? '\n• Valor: ' + clp(price) : '') +
      '\n• Ocasión: ' + $('tlOc').value +
      '\n• Retiro en el local: ' + fecha(fe) + (hr ? ', ' + hr + ' hrs' : '') +
      '\n• Mensaje escrito en la torta: ' + (msj || 'sin mensaje') +
      (idea ? '\n• ' + (DESIGN ? 'Idea' : 'Comentarios') + ': ' + idea : '') +
      '\n¿Me confirmas disponibilidad?';
    $('sGo').href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(t);
    var why = big ? 'Para más de 40 personas cotizamos por WhatsApp.' : DESIGN ? 'Esta torta lleva diseño: la cotizamos por WhatsApp.' : !row ? 'Elige un sabor.' : !vid ? 'Este sabor se pide por WhatsApp.' : !fechaOk ? 'Elige una fecha desde el ' + fecha(MIN) + '.' : !hr ? 'Elige el horario de retiro.' : '';
    var pay = $('sPay'), solo = big || DESIGN;
    pay.hidden = solo; pay.disabled = !!why; $('sWhy').textContent = why;
    pay.textContent = !why ? 'Pagar ' + clp(price) + ' y agendar' : 'Pagar y agendar';
    $('sGo').textContent = solo ? (big ? 'Cotizar por WhatsApp' : 'Cotizar mi diseño por WhatsApp') : 'Prefiero pedir por WhatsApp';
    $('sGo').className = solo ? 'tl-go' : 'tl-wa';
    var e = 'Hola Sabor Rural, soy ' + nom + '. Mi torta lleva un diseño especial, fondant u otro requisito y quiero consultarlo.' +
      (big ? '\nTamaño: más de 40 personas.' : '\nTamaño: ' + st.n + ' personas.') + (row ? '\nSabor que me gusta: ' + row[0] + '.' : '') + (idea ? '\nIdea: ' + idea : '');
    $('tlEsp').href = $('tlEsp2').href = $('tlEsp3').href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(e);
  }
  $('sPay').addEventListener('click', function () {
    var row = st.sel >= 0 ? DATA[st.sel] : null; if (!row || !row[7] || st.n === 'mas') return;
    var props = { 'Retiro': fecha($('tlFe').value) + ', ' + $('tlHr').value + ' hrs', 'Ocasión': $('tlOc').value, 'Mensaje en la torta': $('tlMs').value.trim() || 'Sin mensaje' };
    var c = $('tlId').value.trim(); if (c) props['Comentarios'] = c;
    window.SRPay.buy([{ id: +row[7][idx(st.n)], quantity: 1, properties: props }], this);
  });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { root.classList.toggle('live', es[0].isIntersecting); }).observe(document.querySelector('.tl-esp'));
  /* datos que llegan desde la portada ("Quiero una así", torta de novios) */
  try {
    var q = new URLSearchParams(window.location.search);
    if (q.get('idea')) { $('tlId').value = q.get('idea'); DESIGN = true; }
