{%- liquid
  assign wa = section.settings.whatsapp
  assign wa_txt = section.settings.mensaje | url_encode
  assign wa_var = section.settings.mensaje_variedades | url_encode
  assign carta = section.settings.carta_url
-%}

  <section class="kc-sec" id="kuchen" aria-labelledby="kc-h-{{ section.id }}">
    <div class="wrap">
      <div class="kc-alert" role="note">
        <span class="kc-clock" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg></span>
        <div>
          <small>{{ section.settings.aviso_pre }}</small>
          <strong>{{ section.settings.aviso_titulo }}</strong>
          <span>{{ section.settings.aviso_texto }}</span>
        </div>
      </div>
      <div class="kc-panel">
        <figure class="kc-photo">
          <img src="{{ 'sr-kuchen.jpg' | asset_url }}" alt="Tarta con cobertura rosada, merengues y rodajas de limón frente al letrero de Sabor Rural" width="1200" height="1600" loading="lazy">
          <figcaption class="kc-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ section.settings.insignia }}</figcaption>
        </figure>
        <div>
          <span class="kc-eyebrow">{{ section.settings.eyebrow }}</span>
          <h2 id="kc-h-{{ section.id }}">{{ section.settings.titulo_a }} <em>{{ section.settings.titulo_b }}</em></h2>
          <p class="kc-lead">{{ section.settings.bajada }}</p>
          <p class="kc-gh">1 · Elige tu kuchen</p>
          <div class="kc-flav" id="kcK" role="group" aria-label="Kuchen">
            {%- assign sabores = section.settings.sabores | split: ',' -%}
            {%- for s in sabores -%}{%- assign par = s | split: '|' -%}<button type="button" class="kc-chip" data-n="{{ par[0] | strip | escape }}" data-p="{{ par[1] | strip }}" aria-pressed="false"><b>{{ par[0] | strip }}</b><small>{%- if par[1] != blank -%}${{ par[1] | strip | append: '' | replace: '000', '.000' | replace: '500', '.500' }}{%- else -%}consultar{%- endif -%}</small></button>{%- endfor -%}
          </div>
          <p class="kc-gh">2 · O elige un pie o una tarta</p>
          <div class="kc-flav" id="kcT" role="group" aria-label="Pies y tartas">
            {%- assign tartas = section.settings.tartas | split: ',' -%}
            {%- for s in tartas -%}{%- assign par = s | split: '|' -%}<button type="button" class="kc-chip" data-n="{{ par[0] | strip | escape }}" data-p="{{ par[1] | strip }}" aria-pressed="false"><b>{{ par[0] | strip }}</b><small>{%- if par[1] != blank -%}${{ par[1] | strip | append: '' | replace: '000', '.000' | replace: '500', '.500' }}{%- else -%}consultar{%- endif -%}</small></button>{%- endfor -%}
          </div>
          <p class="kc-hint">Toca para agregar. Precios por porción, según la carta.</p>

          <div class="kc-order" id="kcOrder" hidden>
            <h3>Tu pedido</h3>
            <ul class="kc-lines" id="kcLines"></ul>
            <div class="kc-mode" role="group" aria-label="Tamaño">
              <button type="button" data-m="por" aria-pressed="true">Porciones</button>
              <button type="button" data-m="ent" aria-pressed="false">Pieza entera</button>
            </div>
            <div class="kc-two">
              <label>Retiro<input type="date" id="kcFe"></label>
              <label>Tu nombre<input type="text" id="kcNo" placeholder="Cómo te llamas" autocomplete="given-name"></label>
            </div>
            <div class="kc-total"><span id="kcTl">Total referencial</span><strong id="kcTot">—</strong></div>
            <p class="kc-note" id="kcNt"></p>
          </div>

          <a class="kc-go" id="kcGo" href="https://wa.me/{{ wa }}?text={{ wa_txt }}" target="_blank" rel="noopener"><span id="kcGoT">{{ section.settings.boton }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <p class="kc-fine">Pídelo con un día de anticipación y retíralo en 24 horas en Sabor Rural, Ruta J-60 km 95, Licantén.</p>
          <p class="kc-links"><a href="https://wa.me/{{ wa }}?text={{ wa_var }}" target="_blank" rel="noopener">¿Buscas otra variedad? Consúltala</a><span aria-hidden="true">·</span><a href="{{ carta }}">Ver la carta</a></p>
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
 "name": "Sabor Rural: kuchen",
 "settings": [
  {"type": "text", "id": "aviso_pre", "label": "Banner: texto pequeño", "default": "Importante antes de pedir"},
  {"type": "text", "id": "aviso_titulo", "label": "Banner: título", "default": "Disponible en 24 horas"},
  {"type": "text", "id": "aviso_texto", "label": "Banner: bajada", "default": "Encárgalo hoy y retíralo mañana. Pídelo con un día de anticipación."},
  {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Kuchen, pies y tartas"},
  {"type": "text", "id": "titulo_a", "label": "Título", "default": "Encarga tu"},
  {"type": "text", "id": "titulo_b", "label": "Título (destacado)", "default": "kuchen"},
  {"type": "text", "id": "insignia", "label": "Insignia sobre la foto", "default": "Disponible en 24 horas"},
  {"type": "textarea", "id": "bajada", "label": "Bajada", "default": "Kuchen, pies y tartas hechos desde cero, sin premezclas ni conservantes. Elige el tuyo y retíralo en 24 horas."},
  {"type": "text", "id": "sabores", "label": "Kuchen (formato Nombre|precio por porción, separados por coma)", "default": "Berries|3000, Frambuesa|3000, Frutilla|3000, Manzana canela y nuez|3000, Nuez|3000"},
  {"type": "text", "id": "tartas", "label": "Pies y tartas (formato Nombre|precio por porción, separados por coma; sin precio = consultar)", "default": "Pie de limón|3000, Pie de coco|3000, Banoffee|3500, Tarta Snickers|3000, Tarta chocolate y pistacho|3500, Frambuesa miga|"},
  {"type": "text", "id": "boton", "label": "Texto del botón", "default": "Encargar ahora"},
  {"type": "text", "id": "mensaje", "label": "Mensaje de WhatsApp (encargar)", "default": "Hola Sabor Rural, quiero encargar un kuchen o tarta para mañana."},
  {"type": "text", "id": "mensaje_variedades", "label": "Mensaje de WhatsApp (variedades)", "default": "Hola Sabor Rural, ¿qué variedades de kuchen, pies y tartas tienen para encargar?"},
  {"type": "text", "id": "whatsapp", "label": "WhatsApp (números, con código de país)", "default": "56992101764"},
  {"type": "text", "id": "carta_url", "label": "Enlace de la carta", "default": "/pages/carta"}
 ],
 "presets": [{"name": "Sabor Rural: kuchen"}]
}
{% endschema %}
