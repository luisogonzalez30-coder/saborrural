<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Caveat:wght@500;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<script>
/* Modo liviano: celulares táctiles y equipos con poca memoria o pocos núcleos. Estilos en sr-lite.css. */
(function () {
  var m = navigator.deviceMemory, c = navigator.hardwareConcurrency;
  var touch = window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  if (!(touch || (m && m <= 4) || (c && c <= 4))) return;
  document.documentElement.classList.add('sr-lite');
  var si = window.setInterval;   /* sin giro automático de los carruseles (4,2 s, 4,6 s y 4,8 s); se mueven con el dedo */
  window.setInterval = function (f, t) { if (t === 4200 || t === 4600 || t === 4800) return 0; return si.apply(this, arguments); };
  /* "Nuestro trabajo" con el mismo abanico plano de cookies y café (en vez de la rueda 3D de 25 fotos) */
  function trabajoFan() {
    var ring = document.getElementById('ring'); if (!ring) return;
    var src = Array.prototype.slice.call(ring.querySelectorAll('.rc')), n = src.length; if (n < 3) return;
    var f = document.createElement('div'); f.className = 'nfan tfan'; f.tabIndex = 0; f.setAttribute('role', 'group');
    f.setAttribute('aria-label', 'Galería de nuestras creaciones. Desliza para ver más.');
    var cards = src.map(function (c) {
      var fig = document.createElement('figure'); fig.className = 'ns'; fig.setAttribute('data-g', c.getAttribute('data-group') || '');
      var im = c.querySelector('img');
      if (im) { var i2 = document.createElement('img'); i2.src = im.src; i2.alt = im.alt || ''; i2.width = 420; i2.height = 525; i2.loading = 'lazy'; i2.decoding = 'async'; i2.draggable = false; fig.appendChild(i2); }
      f.appendChild(fig); return fig;
    });
    var pv = document.createElement('button'), nx = document.createElement('button');
    pv.type = nx.type = 'button'; pv.className = 'nnav nprev'; nx.className = 'nnav nnext';
    pv.setAttribute('aria-label', 'Anterior'); nx.setAttribute('aria-label', 'Siguiente'); pv.textContent = '\u2039'; nx.textContent = '\u203A';
    f.appendChild(pv); f.appendChild(nx);
    var info = document.createElement('div'); info.className = 'ninfo tf-info';
    var h3 = document.createElement('h3'), pos = document.createElement('span'); pos.className = 'tf-pos'; info.appendChild(h3); info.appendChild(pos);
    ring.parentNode.insertBefore(f, ring); ring.parentNode.insertBefore(info, ring);
    var cur = Math.floor(n / 2), down = false, moved = false, sx = 0;
    function layout() {
      cards.forEach(function (c, i) {
        var o = i - cur, a = Math.abs(o);
        c.style.setProperty('--o', o); c.style.setProperty('--a', Math.min(a, 4)); c.style.zIndex = 30 - a;
        c.setAttribute('data-a', Math.min(a, 4)); c.classList.toggle('on', i === cur); c.classList.toggle('off', a > 3);
      });
      h3.textContent = cards[cur].getAttribute('data-g'); pos.textContent = (cur + 1) + ' / ' + n;
    }
    function go(i) { cur = Math.max(0, Math.min(n - 1, i)); layout(); }
    cards.forEach(function (c, i) { c.addEventListener('click', function () { if (!moved) go(i); }); });
    f.addEventListener('pointerdown', function (e) { if (e.target.closest('.nnav')) return; down = true; moved = false; sx = e.clientX; });
    f.addEventListener('pointermove', function (e) {
      if (!down) return; var dx = e.clientX - sx;
      if (Math.abs(dx) > 42) { moved = true; down = false; go(cur + (dx < 0 ? 1 : -1)); setTimeout(function () { moved = false; }, 60); }
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (t) { f.addEventListener(t, function () { down = false; }); });
    f.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); } else if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
    });
    pv.addEventListener('click', function () { go(cur - 1); }); nx.addEventListener('click', function () { go(cur + 1); });
    layout(); document.documentElement.classList.add('tf-on');
  }
  document.addEventListener('DOMContentLoaded', function () {
    trabajoFan();
    /* los abanicos nacen ya en su posición final (carta del centro) y sin animación de entrada */
    setTimeout(function () {
      Array.prototype.forEach.call(document.querySelectorAll('.nfan:not(.tfan)'), function (f) {
        var cs = f.querySelectorAll('.ns'); if (cs.length >= 3) cs[Math.floor(cs.length / 2)].click();
      });
      setTimeout(function () { document.documentElement.classList.add('sr-ready'); }, 700);
    }, 0);
    /* mapa y globo: animados solo mientras se ven */
    var svgs = function (r, on) { Array.prototype.forEach.call(r.querySelectorAll('svg'), function (v) { if (on ? v.unpauseAnimations : v.pauseAnimations) { on ? v.unpauseAnimations() : v.pauseAnimations(); } }); };
    svgs(document, false);
    if (!('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { e.target.classList.toggle('live', e.isIntersecting); svgs(e.target, e.isIntersecting); });
    }, { rootMargin: '60px' });
    ['llegar', 'cafe'].forEach(function (id) { var s = document.getElementById(id); if (s) io.observe(s); });
  });
})();
</script>
