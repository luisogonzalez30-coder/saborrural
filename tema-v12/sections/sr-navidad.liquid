{%- liquid
  assign u1 = section.settings.url_tortas | default: '/pages/tortas'
  assign u2 = section.settings.url_kuchen | default: '/products/kuchen-tarta-entera'
  assign lista = section.settings.fotos | default: 'sr-nav-01.jpg,sr-nav-02.jpg,sr-nav-03.jpg,sr-nav-04.jpg,sr-nav-05.jpg,sr-nav-06.jpg,sr-nav-07.jpg,sr-nav-08.jpg,sr-nav-09.jpg,sr-nav-10.jpg,sr-nav-11.jpg'
  assign fotos = lista | split: ','
-%}
<div class="sr nv" id="nv" data-fecha="{{ section.settings.fecha_navidad }}">
<style>
.nv{--pk:#F59AAC;--pk2:#E2587C;--gd:#E8C778;--rd:#B02A43;--gr:#1F5A3B;position:relative;background:linear-gradient(180deg,#5E0F20 0%,#2A0A12 38%,#0C0D0F 100%);color:#F3F1EA;overflow:hidden;isolation:isolate}
.nv *{box-sizing:border-box}
.nv .nv-bar{position:relative;z-index:3;background:linear-gradient(90deg,#14502F,#1F5A3B 50%,#14502F);color:#fff;text-align:center;padding:10px 14px;font:700 .9rem/1.3 var(--font-body)}
.nv .nv-bar a{color:var(--gd);text-decoration:underline;text-underline-offset:3px;margin-left:6px;white-space:nowrap}
.nv .nv-snow{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.nv .nv-snow i{position:absolute;top:-12px;width:var(--s);height:var(--s);border-radius:50%;background:#fff;opacity:.85;filter:blur(.4px);animation:nvfall var(--d) linear var(--l) infinite}
@keyframes nvfall{to{transform:translate3d(var(--x),105vh,0)}}
.nv .nv-gar{position:relative;z-index:2;height:96px;margin-top:-2px}
.nv .nv-gar svg{display:block;width:100%;height:100%}
.nv .nv-gar .lt{animation:nvtw 1.8s ease-in-out infinite}
.nv .nv-gar .lt:nth-child(3n){animation-delay:.6s}.nv .nv-gar .lt:nth-child(3n+1){animation-delay:1.2s}
@keyframes nvtw{0%,100%{opacity:.35}50%{opacity:1}}
.nv .nv-w{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:6px max(16px,env(safe-area-inset-left,0px)) 28px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:28px;align-items:center}
.nv .nv-txt{display:flex;flex-direction:column;gap:16px}
.nv .nv-tag{align-self:flex-start;font:700 12.5px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:#1A0A0F;background:linear-gradient(135deg,var(--gd),#C99A3C);padding:8px 14px;border-radius:99px}
.nv h2{margin:0;font:800 clamp(2.3rem,8.4vw,4.4rem)/1 var(--font-display);letter-spacing:-.03em;color:#fff;text-shadow:0 2px 18px rgba(0,0,0,.6)}
.nv h2 em{display:block;font-family:var(--font-chalk);font-style:normal;font-weight:700;color:var(--gd);font-size:1.2em;letter-spacing:0}
.nv .nv-lead{margin:0;font-family:var(--font-body);max-width:29em;color:#F3F1EA;font-size:clamp(1rem,2.9vw,1.15rem);line-height:1.5}
.nv .nv-count{display:flex;gap:10px;align-items:center;font:700 .98rem/1 var(--font-body);color:#E4D6DA}
.nv .nv-count b{font:800 2.2rem/1 var(--font-display);color:var(--gd)}
.nv .nv-cta{display:flex;flex-wrap:wrap;gap:12px}
.nv .nv-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:99px;font:800 1rem/1 var(--font-display);text-decoration:none}
.nv .nv-btn.p{background:linear-gradient(135deg,#F7A9B8,var(--pk2));color:#1A0A0F}
.nv .nv-btn.s{border:1.5px solid var(--gd);color:var(--gd);background:rgba(10,8,10,.45)}
.nv .nv-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.nv .nv-chips li{padding:9px 14px;border:1px solid rgba(232,199,120,.45);border-radius:99px;background:rgba(10,8,10,.5);font:600 .88rem/1 var(--font-body)}
.nv .nv-fan{position:relative;height:420px}
.nv .nv-fan figure{position:absolute;margin:0;width:46%;aspect-ratio:3/4;padding:8px 8px 26px;background:#fff;border-radius:6px;box-shadow:0 18px 40px rgba(0,0,0,.55)}
.nv .nv-fan figure img{display:block;width:100%;height:100%;object-fit:cover;border-radius:3px}
.nv .nv-fan figure:nth-child(1){left:0;top:46px;transform:rotate(-8deg)}
.nv .nv-fan figure:nth-child(2){left:27%;top:0;transform:rotate(3deg);z-index:2}
.nv .nv-fan figure:nth-child(3){right:0;top:64px;transform:rotate(9deg)}
.nv .nv-fan figure::after{content:"";position:absolute;top:-10px;left:50%;width:46px;height:16px;margin-left:-23px;background:rgba(232,199,120,.85);transform:rotate(-3deg);border-radius:2px}
.nv .nv-rail{position:relative;z-index:2;padding:6px 0 34px}
.nv .nv-rail h3{margin:0 0 14px;text-align:center;font:700 1.9rem/1 var(--font-chalk);color:var(--gd)}
.nv .nv-track{display:flex;gap:16px;width:max-content;animation:nvslide 52s linear infinite}
.nv .nv-rail:hover .nv-track{animation-play-state:paused}
@keyframes nvslide{to{transform:translateX(-50%)}}
.nv .nv-card{flex:none;width:200px;aspect-ratio:3/4;border-radius:18px;overflow:hidden;border:2px solid var(--gd);box-shadow:0 10px 26px rgba(0,0,0,.5)}
.nv .nv-card img{display:block;width:100%;height:100%;object-fit:cover}
@media (max-width:820px){.nv .nv-w{grid-template-columns:1fr}.nv .nv-fan{height:340px;order:-1}.nv .nv-card{width:150px}.nv .nv-cta .nv-btn{flex:1 1 100%}}
@media (prefers-reduced-motion:reduce){.nv .nv-track,.nv .nv-snow i,.nv .nv-gar .lt{animation:none}.nv .nv-rail{overflow-x:auto}}
html.sr-lite .nv .nv-track,html.sr-lite .nv .nv-snow i,html.sr-lite .nv .nv-gar .lt{animation:none}
html.sr-lite .nv .nv-rail{overflow-x:auto}
</style>
{%- if section.settings.mostrar_barra -%}
<div class="nv-bar">🎄 {{ section.settings.barra }}<a href="{{ u1 }}">Reservar</a></div>
{%- endif -%}
<div class="nv-snow" aria-hidden="true">
{%- for i in (1..34) -%}
  {%- assign m = i | times: 37 | modulo: 100 -%}
  <i style="left:{{ m }}%;--s:{{ i | modulo: 4 | plus: 3 }}px;--d:{{ i | modulo: 7 | plus: 9 }}s;--l:-{{ i | modulo: 11 }}s;--x:{{ i | modulo: 5 | minus: 2 | times: 28 }}px"></i>
{%- endfor -%}
</div>
<div class="nv-gar" aria-hidden="true">
<svg viewBox="0 0 1200 96" preserveAspectRatio="xMidYMin slice">
<path d="M-10 14 Q300 78 600 24 T1210 14" fill="none" stroke="#14502F" stroke-width="16" stroke-linecap="round"/>
<path d="M-10 14 Q300 78 600 24 T1210 14" fill="none" stroke="#2E8B57" stroke-width="6" stroke-dasharray="3 7" stroke-linecap="round"/>
<g>
{%- assign cs = '#FFD66B,#FF5A5F,#7CE3A0,#FFF2C2' | split: ',' -%}
{%- for p in (0..13) -%}{%- assign t = p | times: 86 | plus: 30 -%}{%- assign ci = p | modulo: 4 -%}
<circle class="lt" cx="{{ t }}" cy="58" r="5" fill="{{ cs[ci] }}"></circle>
{%- endfor -%}
</g>
<g><circle cx="150" cy="62" r="15" fill="#B02A43"/><circle cx="144" cy="56" r="4" fill="#fff" opacity=".5"/><circle cx="420" cy="70" r="12" fill="#E8C778"/><circle cx="600" cy="38" r="17" fill="#B02A43"/><circle cx="594" cy="32" r="4" fill="#fff" opacity=".5"/><circle cx="800" cy="62" r="12" fill="#E8C778"/><circle cx="1040" cy="56" r="15" fill="#B02A43"/></g>
</svg>
</div>
<div class="nv-w">
  <div class="nv-txt">
    <span class="nv-tag">{{ section.settings.etiqueta }}</span>
    <h2>{{ section.settings.titulo_a }} <em>{{ section.settings.titulo_b }}</em></h2>
    <p class="nv-lead">{{ section.settings.bajada }}</p>
    <div class="nv-count" aria-live="polite"><b id="nv-dias">–</b><span id="nv-txt">días para Navidad</span></div>
    <div class="nv-cta">
      <a class="nv-btn p" href="{{ u1 }}">{{ section.settings.boton_1 }}</a>
      <a class="nv-btn s" href="{{ u2 }}">{{ section.settings.boton_2 }}</a>
    </div>
    <ul class="nv-chips"><li>Hecho desde cero</li><li>Pagas en línea</li><li>Retiro gratis en el local</li></ul>
  </div>
  <div class="nv-fan" aria-hidden="true">
    {%- for k in (0..2) -%}{%- assign f = fotos[k] | strip | file_url -%}
    <figure><img src="{{ f }}{% if f contains '?' %}&{% else %}?{% endif %}width=420" alt="" width="420" height="560" loading="eager"></figure>
    {%- endfor -%}
  </div>
</div>
<div class="nv-rail">
  <h3>{{ section.settings.carrusel }}</h3>
  <div style="overflow:hidden"><div class="nv-track">
  {%- for vuelta in (1..2) -%}{%- for n in fotos -%}{%- assign f = n | strip | file_url -%}
    <div class="nv-card"><img src="{{ f }}{% if f contains '?' %}&{% else %}?{% endif %}width=400" alt="Torta de Sabor Rural" width="400" height="533" loading="lazy"></div>
  {%- endfor -%}{%- endfor -%}
  </div></div>
</div>
<script>
(function(){var r=document.getElementById('nv');if(!r)return;var f=(r.getAttribute('data-fecha')||'').split('-');
var n=new Date();var y=+f[0]||n.getFullYear(),m=(+f[1]||12)-1,d=+f[2]||25;var t=new Date(y,m,d);var h=new Date(n.getFullYear(),n.getMonth(),n.getDate());
var dias=Math.round((t-h)/864e5);var b=document.getElementById('nv-dias'),x=document.getElementById('nv-txt');
if(dias>1){b.textContent=dias;x.textContent='días para Navidad';}else if(dias===1){b.textContent='1';x.textContent='día para Navidad';}else if(dias===0){b.textContent='¡Hoy!';x.textContent='es Navidad';}else{r.querySelector('.nv-count').style.display='none';}})();
</script>
</div>
{% schema %}
{
 "name": "Sabor Rural: Navidad",
 "settings": [
  {"type": "checkbox", "id": "mostrar_barra", "label": "Mostrar barra superior", "default": true},
  {"type": "text", "id": "barra", "label": "Texto de la barra", "default": "Navidad en Sabor Rural: reserva tu torta y tus kuchen."},
  {"type": "text", "id": "etiqueta", "label": "Etiqueta", "default": "Navidad 2026"},
  {"type": "text", "id": "titulo_a", "label": "Título", "default": "Reserva tu"},
  {"type": "text", "id": "titulo_b", "label": "Título (destacado)", "default": "torta navideña"},
  {"type": "textarea", "id": "bajada", "label": "Bajada", "default": "Tortas y kuchen por encargo para tu mesa de Navidad. Elige con tiempo y paga en línea."},
  {"type": "text", "id": "fecha_navidad", "label": "Fecha de Navidad (AAAA-MM-DD)", "default": "2026-12-25"},
  {"type": "text", "id": "boton_1", "label": "Botón 1", "default": "Reservar mi torta"},
  {"type": "url", "id": "url_tortas", "label": "Enlace botón 1"},
  {"type": "text", "id": "boton_2", "label": "Botón 2", "default": "Ver kuchen"},
  {"type": "url", "id": "url_kuchen", "label": "Enlace botón 2"},
  {"type": "text", "id": "carrusel", "label": "Título del carrusel", "default": "Tortas para tu mesa de Navidad"},
  {"type": "textarea", "id": "fotos", "label": "Fotos del carrusel (nombres de Contenido > Archivos, separados por coma; las 3 primeras van en las fotos de arriba)", "default": "sr-nav-01.jpg,sr-nav-02.jpg,sr-nav-03.jpg,sr-nav-04.jpg,sr-nav-05.jpg,sr-nav-06.jpg,sr-nav-07.jpg,sr-nav-08.jpg,sr-nav-09.jpg,sr-nav-10.jpg,sr-nav-11.jpg"}
 ],
 "presets": [{"name": "Sabor Rural: Navidad"}]
}
{% endschema %}
