{%- liquid
  assign wa = section.settings.whatsapp
  assign wa_txt = section.settings.mensaje | url_encode
-%}
<style>
.sr .gf{padding:30px 0}
.sr .gf-panel{position:relative;overflow:hidden;display:grid;gap:18px;justify-items:center;text-align:center;border:1px solid rgba(242,132,151,.45);border-radius:28px;padding:34px 20px 30px;background:radial-gradient(90% 80% at 85% 0%,rgba(194,48,72,.5),transparent 68%),radial-gradient(70% 60% at 0% 100%,rgba(240,124,149,.22),transparent 70%),linear-gradient(165deg,#2A1119,#120A0E 72%);box-shadow:0 40px 70px -42px rgba(194,48,72,.75)}
.sr .gf-ico{width:64px;height:64px;color:#F59AAC}
.sr .gf-eyebrow{display:inline-block;font:700 12.5px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:#1A0A0F;background:linear-gradient(135deg,#F59AAC,#E2587C);padding:8px 14px;border-radius:99px}
.sr .gf h2{font:800 clamp(2rem,8.6vw,3.8rem)/1 var(--font-display);letter-spacing:-.03em;color:#fff;margin:0;max-width:13em}
.sr .gf h2 em{font-family:var(--font-chalk);font-style:normal;font-weight:700;color:#F59AAC;font-size:1.2em;letter-spacing:0}
.sr .gf p{margin:0;max-width:34em;color:#E4D6DA;font-size:clamp(1rem,2.9vw,1.15rem);line-height:1.5}
.sr .gf-go{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;max-width:520px;min-height:68px;border-radius:18px;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;font:800 clamp(1.1rem,4.6vw,1.4rem)/1 var(--font-display);letter-spacing:-.01em;text-decoration:none;box-shadow:0 18px 36px -14px rgba(226,88,124,.9);position:relative;transition:transform .15s,filter .15s}
.sr .gf-go::after{content:"";position:absolute;inset:0;border-radius:inherit;border:2px solid #F59AAC;opacity:0;pointer-events:none;animation:gf-ring 2.4s ease-out infinite;animation-play-state:paused}
.sr .gf.live .gf-go::after{animation-play-state:running}
.sr .gf-go:hover{filter:brightness(1.07);transform:translateY(-2px)}
.sr .gf-go:active{transform:scale(.98)}
.sr .gf-go svg{width:26px;height:26px;transition:transform .2s}
.sr .gf-go:hover svg{transform:translateX(6px)}
@keyframes gf-ring{0%{transform:scale(1);opacity:.75}100%{transform:scale(1.1,1.3);opacity:0}}
@media (prefers-reduced-motion:reduce){.sr .gf-go::after{animation:none}}
</style>
<div class="sr">
  <section class="gf" id="regala" aria-labelledby="gf-h-{{ section.id }}">
    <div class="wrap">
      <div class="gf-panel">
        <svg class="gf-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/><path d="M7.5 8a2.5 2.5 0 1 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 1 1 0 5"/></svg>
        <span class="gf-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 id="gf-h-{{ section.id }}">{{ section.settings.titulo_a }} <em>{{ section.settings.titulo_b }}</em></h2>
        <p>{{ section.settings.bajada }}</p>
        <a class="gf-go" href="https://wa.me/{{ wa }}?text={{ wa_txt }}" target="_blank" rel="noopener">{{ section.settings.boton }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</div>
<script>(function(){var s=document.getElementById('regala');if(!s)return;if(!('IntersectionObserver' in window)){s.classList.add('live');return}new IntersectionObserver(function(es){es.forEach(function(e){s.classList.toggle('live',e.isIntersecting)})},{rootMargin:'80px'}).observe(s)})();</script>
{% schema %}
{
 "name": "Sabor Rural: botón gift card",
 "settings": [
  {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Gift card"},
  {"type": "text", "id": "titulo_a", "label": "Título", "default": "Regala una visita a"},
  {"type": "text", "id": "titulo_b", "label": "Título (destacado)", "default": "Sabor Rural"},
  {"type": "textarea", "id": "bajada", "label": "Bajada", "default": "Una gift card para quien ama el café o necesita una pausa. Pídela por WhatsApp."},
  {"type": "text", "id": "boton", "label": "Texto del botón", "default": "Compra aquí tu gift card"},
  {"type": "text", "id": "whatsapp", "label": "WhatsApp (solo números, con código de país)", "default": "56992101764"},
  {"type": "text", "id": "mensaje", "label": "Mensaje de WhatsApp", "default": "Hola Sabor Rural, quiero comprar una gift card."}
 ],
 "presets": [{"name": "Sabor Rural: botón gift card"}]
}
{% endschema %}
