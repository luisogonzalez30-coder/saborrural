{%- liquid
  assign wa = section.settings.whatsapp
  assign wa_txt = section.settings.mensaje | url_encode
  assign wa_var = section.settings.mensaje_variedades | url_encode
  assign carta = section.settings.carta_url
-%}
<div class="sr kc">
<style>
.kc{--ln:rgba(242,132,151,.3)}
.kc .kc-sec{padding:34px 0}
.kc .kc-alert{position:relative;display:flex;align-items:center;gap:16px;margin:0 0 16px;padding:18px 18px;border-radius:24px;color:#1A0A0F;background:repeating-linear-gradient(-45deg,rgba(255,255,255,.14) 0 14px,transparent 14px 28px),linear-gradient(135deg,#F9B8C5,#E2587C 70%,#D2406A);box-shadow:0 26px 50px -22px rgba(226,88,124,.95),inset 0 0 0 2px rgba(255,255,255,.35)}
.kc .kc-clock{position:relative;flex:none;width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:#1A0A0F;color:#F9B8C5}
.kc .kc-clock svg{position:absolute;left:50%;top:50%;width:34px;height:34px;margin:0;transform:translate(-50%,-50%);display:block}
.kc .kc-clock::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:3px solid #fff;opacity:0;pointer-events:none;animation:kc-ping 1.9s ease-out infinite;animation-play-state:paused}
.kc.live .kc-clock::after{animation-play-state:running}
@keyframes kc-ping{0%{transform:scale(.9);opacity:.9}100%{transform:scale(1.5);opacity:0}}
.kc .kc-alert small{display:block;font:800 .74rem/1 var(--font-body);letter-spacing:.2em;text-transform:uppercase;opacity:.85}
.kc .kc-alert strong{display:block;margin:6px 0 0;font:800 clamp(1.7rem,7.6vw,2.9rem)/.98 var(--font-display);letter-spacing:-.03em}
.kc .kc-alert span{display:block;margin-top:6px;font:700 clamp(.95rem,3.6vw,1.12rem)/1.25 var(--font-body)}
@media (min-width:860px){.kc .kc-alert{padding:22px 30px;gap:24px}.kc .kc-clock{width:84px;height:84px}.kc .kc-clock svg{width:44px;height:44px}}
.kc .kc-panel{position:relative;overflow:hidden;display:grid;gap:22px;border:1px solid var(--ln);border-radius:30px;padding:22px 18px 26px;background:radial-gradient(90% 70% at 100% 0%,rgba(194,48,72,.42),transparent 68%),radial-gradient(70% 60% at 0% 100%,rgba(240,124,149,.18),transparent 70%),linear-gradient(165deg,#2A1119,#120A0E 72%);box-shadow:0 40px 70px -42px rgba(194,48,72,.7)}
@media (min-width:860px){.kc .kc-panel{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);align-items:center;gap:38px;padding:34px 38px}}
.kc .kc-photo{position:relative;margin:0;border-radius:22px;overflow:hidden;aspect-ratio:3/4;background:#120A0E;box-shadow:0 26px 50px -30px rgba(0,0,0,.9)}
.kc .kc-photo img{display:block;width:100%;height:100%;object-fit:cover}
.kc .kc-badge{position:absolute;left:12px;bottom:12px;display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border-radius:99px;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;font:800 .98rem/1 var(--font-display);box-shadow:0 12px 24px -10px rgba(226,88,124,.9)}
.kc .kc-badge svg{width:18px;height:18px}
.kc .kc-eyebrow{display:inline-block;font:700 12.5px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:#1A0A0F;background:linear-gradient(135deg,#F59AAC,#E2587C);padding:8px 14px;border-radius:99px}
.kc h2{font:800 clamp(2.1rem,8.6vw,3.6rem)/1 var(--font-display);letter-spacing:-.03em;color:#fff;margin:14px 0 0}
.kc h2 em{font-family:var(--font-chalk);font-style:normal;font-weight:700;color:#F59AAC;font-size:1.2em;letter-spacing:0}
.kc .kc-lead{margin:14px 0 0;color:#E4D6DA;font-size:clamp(1rem,2.9vw,1.14rem);line-height:1.5}
.kc .kc-gh{margin:20px 0 0;font:800 .8rem/1 var(--font-body);letter-spacing:.16em;text-transform:uppercase;color:#F59AAC}
.kc .kc-flav{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0;padding:0}
.kc .kc-chip{display:grid;gap:3px;text-align:left;padding:10px 14px;border:1.5px solid var(--ln);border-radius:14px;background:rgba(10,8,10,.55);color:#F3F1EA;cursor:pointer;font-family:var(--font-body)}
.kc .kc-chip b{font:700 .92rem/1.15 var(--font-body);color:#fff}
.kc .kc-chip small{font:800 .76rem/1.15 var(--font-body);color:#F8B7C4}
.kc .kc-chip[aria-pressed="true"]{border-color:#F59AAC;background:linear-gradient(160deg,#4A1A28,#1B0C12 80%);box-shadow:0 0 0 1px rgba(245,154,172,.55)}
.kc .kc-chip[aria-pressed="true"] b::before{content:"✓ ";color:#F59AAC}
.kc .kc-hint{margin:10px 0 0;color:#BFB4B7;font:500 .86rem/1.4 var(--font-body)}
.kc .kc-order{margin:18px 0 0;padding:16px 16px 14px;border:1.5px solid rgba(245,154,172,.55);border-radius:20px;background:rgba(10,6,8,.72);display:grid;gap:12px}
.kc .kc-order[hidden]{display:none}
.kc .kc-order h3{margin:0;font:800 1.2rem/1.1 var(--font-display);color:#fff}
.kc .kc-lines{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.kc .kc-lines li{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1)}
.kc .kc-lines li:last-child{border-bottom:0}
.kc .kc-lines .nm{font:700 .95rem/1.2 var(--font-body);color:#fff}
.kc .kc-lines .nm small{display:block;margin-top:2px;font:500 .8rem/1.2 var(--font-body);color:#C9CBC2}
.kc .kc-lines .pr{font:800 .98rem/1 var(--font-display);color:#F8B7C4;min-width:58px;text-align:right}
.kc .kc-step{display:inline-flex;align-items:center;border:1.5px solid #34373E;border-radius:10px;overflow:hidden;background:#0C0D0F}
.kc .kc-step button{width:34px;height:36px;border:0;background:transparent;color:#F3F1EA;font:700 1.15rem/1 var(--font-body);cursor:pointer}
.kc .kc-step output{min-width:28px;text-align:center;font:800 .95rem/1 var(--font-body);color:#fff}
.kc .kc-mode{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:4px;border-radius:12px;background:#0C0D0F;border:1px solid #2A2D33}
.kc .kc-mode button{min-height:40px;border:0;border-radius:9px;background:transparent;color:#C9CBC2;font:700 .9rem/1 var(--font-body);cursor:pointer}
.kc .kc-mode button[aria-pressed="true"]{background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F}
.kc .kc-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.kc .kc-two label{min-width:0;display:grid;gap:5px;font:700 .8rem/1.2 var(--font-body);color:#E4D6DA}
.kc .kc-two input{min-width:0;box-sizing:border-box;width:100%;min-height:44px;padding:0 10px;border-radius:10px;border:1.5px solid #34373E;background:#0C0D0F;color:#F3F1EA;font:500 15px var(--font-body)}
.kc .kc-total{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,.14)}
.kc .kc-total span{color:#C9CBC2;font-size:.9rem}
.kc .kc-total strong{font:800 1.7rem/1 var(--font-display);color:#fff}
.kc .kc-note{margin:0;color:#BFB4B7;font:500 .84rem/1.4 var(--font-body)}
.kc .kc-fine{margin:12px 0 0;color:#D3C9CC;font:600 .9rem/1.4 var(--font-body);text-align:center}
.kc .kc-links{margin:10px 0 0;display:flex;flex-wrap:wrap;justify-content:center;gap:6px 10px;color:#8E9086}
.kc .kc-links a{color:#F3F1EA;font:700 .9rem/1.2 var(--font-body);text-decoration:underline;text-decoration-color:rgba(245,154,172,.6);text-underline-offset:4px}
.kc .kc-links a:hover{color:#F59AAC}
.kc .kc-go{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:66px;margin:22px 0 0;border-radius:18px;background:linear-gradient(135deg,#F7A9B8,#E2587C);color:#1A0A0F;font:800 clamp(1.1rem,4.6vw,1.35rem)/1 var(--font-display);text-decoration:none;box-shadow:0 18px 36px -14px rgba(226,88,124,.9);transition:transform .15s,filter .15s}
.kc .kc-go:hover{filter:brightness(1.07);transform:translateY(-2px)}
.kc .kc-go:active{transform:scale(.98)}
.kc .kc-go svg{width:26px;height:26px}
.kc .kc-note{margin:14px 0 0;color:#BFB4B7;font:500 .88rem/1.4 var(--font-body)}
@media (prefers-reduced-motion:reduce){.kc .kc-clock::after{animation:none}}
</style>
  <section class="kc-sec" id="kuchen" aria-labelledby="kc-h-{{ section.id }}">
    <div class="wrap">
      <div class="kc-alert" role="note">
        <span class="kc-clock" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg></span>
        <div>
          <small>{{ section.settings.aviso_pre }}</small>
          <strong>{{ section.settings.aviso_titulo }}</strong>
          <span>{{ section.settings.aviso_texto }}</span>
        </div>
      </div>
      <div class="kc-panel">
        <figure class="kc-photo">
          <img src="{{ 'sr-kuchen.jpg' | asset_url }}" alt="Tarta con cobertura rosada, merengues y rodajas de limón frente al letrero de Sabor Rural" width="1200" height="1600" loading="lazy">
          <figcaption class="kc-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ section.settings.insignia }}</figcaption>
        </figure>
        <div>
          <span class="kc-eyebrow">{{ section.settings.eyebrow }}</span>
          <h2 id="kc-h-{{ section.id }}">{{ section.settings.titulo_a }} <em>{{ section.settings.titulo_b }}</em></h2>
          <p class="kc-lead">{{ section.settings.bajada }}</p>
          <p class="kc-gh">1 · Elige tu kuchen</p>
          <div class="kc-flav" id="kcK" role="group" aria-label="Kuchen">
            {%- assign sabores = section.settings.sabores | split: ',' -%}
            {%- for s in sabores -%}{%- assign par = s | split: '|' -%}{%- assign pp = par[1] | strip | plus: 0 -%}{%- assign pe = par[2] | strip | plus: 0 -%}<button type="button" class="kc-chip" data-n="{{ par[0] | strip | escape }}" data-p="{{ pp }}" data-e="{{ pe }}" aria-pressed="false"><b>{{ par[0] | strip }}</b><small>{%- if pp > 0 -%}Porción ${{ pp | divided_by: 1000 | floor }}.{{ pp | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{%- else -%}Porción: consultar{%- endif -%}</small><small>{%- if pe > 0 -%}Entera ${{ pe | divided_by: 1000 | floor }}.{{ pe | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{%- else -%}Entera: consultar{%- endif -%}</small></button>{%- endfor -%}
          </div>
          <p class="kc-gh">2 · O elige un pie o una tarta</p>
          <div class="kc-flav" id="kcT" role="group" aria-label="Pies y tartas">
            {%- assign tartas = section.settings.tartas | split: ',' -%}
            {%- for s in tartas -%}{%- assign par = s | split: '|' -%}{%- assign pp = par[1] | strip | plus: 0 -%}{%- assign pe = par[2] | strip | plus: 0 -%}<button type="button" class="kc-chip" data-n="{{ par[0] | strip | escape }}" data-p="{{ pp }}" data-e="{{ pe }}" aria-pressed="false"><b>{{ par[0] | strip }}</b><small>{%- if pp > 0 -%}Porción ${{ pp | divided_by: 1000 | floor }}.{{ pp | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{%- else -%}Porción: consultar{%- endif -%}</small><small>{%- if pe > 0 -%}Entera ${{ pe | divided_by: 1000 | floor }}.{{ pe | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3 }}{%- else -%}Entera: consultar{%- endif -%}</small></button>{%- endfor -%}
          </div>
          <p class="kc-hint">Toca para agregar. Precios de la carta: por porción y pieza entera.</p>

          <div class="kc-order" id="kcOrder" hidden>
            <h3>Tu pedido</h3>
            <ul class="kc-lines" id="kcLines"></ul>
            <div class="kc-mode" role="group" aria-label="Tamaño">
              <button type="button" data-m="por" aria-pressed="true">Porciones</button>
              <button type="button" data-m="ent" aria-pressed="false">Pieza entera</button>
            </div>
            <div class="kc-two">
              <label>Retiro<input type="date" id="kcFe"></label>
              <label>Tu nombre<input type="text" id="kcNo" placeholder="Cómo te llamas" autocomplete="given-name"></label>
            </div>
            <div class="kc-total"><span id="kcTl">Total referencial</span><strong id="kcTot">—</strong></div>
            <p class="kc-note" id="kcNt"></p>
          </div>

          <a class="kc-go" id="kcGo" href="https://wa.me/{{ wa }}?text={{ wa_txt }}" target="_blank" rel="noopener"><span id="kcGoT">{{ section.settings.boton }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <p class="kc-fine">Pídelo con un día de anticipación y retíralo en 24 horas en Sabor Rural, Ruta J-60 km 95, Licantén.</p>
          <p class="kc-links"><a href="https://wa.me/{{ wa }}?text={{ wa_var }}" target="_blank" rel="noopener">¿Buscas otra variedad? Consúltala</a><span aria-hidden="true">·</span><a href="{{ carta }}">Ver la carta</a></p>
        </div>
      </div>
    </div>
  </section>
</div>
<script>
(function () {
  var root = document.querySelector('.kc'); if (!root) return;
  var WA = {{ wa | json }}, BASE = {{ section.settings.mensaje | json }};
  var items = {}, mode = 'por', order = [];
  function $(id) { return document.getElementById(id); }
  function clp(n) { return '$' + String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function el(t, c, x) { var e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; }
  function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
  function fecha(v) { if (!v) return 'mañana'; var p = v.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
  var man = new Date(); man.setDate(man.getDate() + 1); $('kcFe').min = iso(man); $('kcFe').value = iso(man);
  Array.prototype.forEach.call(root.querySelectorAll('.kc-chip'), function (b) {
    b.addEventListener('click', function () {
      var n = b.getAttribute('data-n');
      if (items[n]) { delete items[n]; order = order.filter(function (x) { return x !== n; }); b.setAttribute('aria-pressed', 'false'); }
      else { items[n] = { q: 1, p: +b.getAttribute('data-p') || 0, e: +b.getAttribute('data-e') || 0, btn: b }; order.push(n); b.setAttribute('aria-pressed', 'true'); }
      render();
    });
  });
  Array.prototype.forEach.call(root.querySelectorAll('.kc-mode button'), function (b) {
    b.addEventListener('click', function () {
      mode = b.getAttribute('data-m');
      Array.prototype.forEach.call(root.querySelectorAll('.kc-mode button'), function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      render();
    });
  });
  ['kcFe', 'kcNo'].forEach(function (id) { $(id).addEventListener('input', render); $(id).addEventListener('change', render); });
  function render() {
    var box = $('kcOrder'), ul = $('kcLines'); box.hidden = !order.length; ul.textContent = '';
    var total = 0, unk = 0, lines = [];
    order.forEach(function (n) {
      var it = items[n], li = el('li'), nm = el('span', 'nm', n), u = mode === 'por' ? it.p : it.e;
      var sub = u ? clp(u) + (mode === 'por' ? ' c/porción' : ' c/pieza entera') : 'precio por confirmar';
      nm.appendChild(el('small', null, sub));
      var st = el('span', 'kc-step'), m = el('button', null, '−'), o = el('output', null, it.q), pl = el('button', null, '+');
      m.type = pl.type = 'button'; m.setAttribute('aria-label', 'Menos ' + n); pl.setAttribute('aria-label', 'Más ' + n);
      m.addEventListener('click', function () { if (it.q > 1) it.q--; else { delete items[n]; order = order.filter(function (x) { return x !== n; }); it.btn.setAttribute('aria-pressed', 'false'); } render(); });
      pl.addEventListener('click', function () { it.q++; render(); });
      st.appendChild(m); st.appendChild(o); st.appendChild(pl);
      var pr = el('span', 'pr', u ? clp(u * it.q) : '—');
      li.appendChild(nm); li.appendChild(st); li.appendChild(pr); ul.appendChild(li);
      if (u) total += u * it.q; else unk++;
      lines.push('• ' + it.q + ' × ' + n + (mode === 'por' ? ' (porciones)' : ' (pieza entera)') + (u ? ' — ' + clp(u * it.q) : ' — precio por confirmar'));
    });
    var ent = mode === 'ent';
    $('kcTot').textContent = !order.length ? '—' : clp(total) + (unk ? ' +' : '');
    $('kcTl').textContent = ent ? 'Total (piezas enteras)' : 'Total (porciones)';
    $('kcNt').textContent = unk ? 'Falta confirmar el precio de algunos productos: te lo decimos por WhatsApp.' : (ent ? 'Valor de la carta por pieza entera. Confirmamos disponibilidad por WhatsApp.' : 'Valor de la carta por porción. Confirmamos disponibilidad por WhatsApp.');
    var go = $('kcGo');
    if (!order.length) { go.href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(BASE); $('kcGoT').textContent = {{ section.settings.boton | json }}; return; }
    var nom = $('kcNo').value.trim() || '[tu nombre]';
    var t = 'Hola Sabor Rural, soy ' + nom + '. Quiero encargar para retirar el ' + fecha($('kcFe').value) + ':\n' + lines.join('\n') +
      '\nTotal: ' + clp(total) + (unk ? ' (más lo que falta confirmar)' : '') +
      '\nRetiro en el local. ¿Me confirmas disponibilidad?';
    go.href = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(t);
    $('kcGoT').textContent = 'Pedir por WhatsApp' + (total ? ' · ' + clp(total) : '');
  }
  render();
})();
</script>
<script>(function(){var s=document.querySelector('.kc');if(!s)return;if(!('IntersectionObserver' in window)){s.classList.add('live');return}new IntersectionObserver(function(es){es.forEach(function(e){s.classList.toggle('live',e.isIntersecting)})},{rootMargin:'80px'}).observe(s)})();</script>
{% schema %}
{
 "name": "Sabor Rural: kuchen",
 "settings": [
  {"type": "text", "id": "aviso_pre", "label": "Banner: texto pequeño", "default": "Importante antes de pedir"},
  {"type": "text", "id": "aviso_titulo", "label": "Banner: título", "default": "Disponible en 24 horas"},
  {"type": "text", "id": "aviso_texto", "label": "Banner: bajada", "default": "Encárgalo hoy y retíralo mañana. Pídelo con un día de anticipación."},
  {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Kuchen, pies y tartas"},
  {"type": "text", "id": "titulo_a", "label": "Título", "default": "Encarga tu"},
  {"type": "text", "id": "titulo_b", "label": "Título (destacado)", "default": "kuchen"},
  {"type": "text", "id": "insignia", "label": "Insignia sobre la foto", "default": "Disponible en 24 horas"},
  {"type": "textarea", "id": "bajada", "label": "Bajada", "default": "Kuchen, pies y tartas hechos desde cero, sin premezclas ni conservantes. Elige el tuyo y retíralo en 24 horas."},
  {"type": "text", "id": "sabores", "label": "Kuchen: Nombre|porción|entera", "default": "Berries|3000|17000, Frambuesa|3000|17000, Frutilla|3000|17000, Manzana canela y nuez|3000|17000, Nuez|3000|17000"},
  {"type": "text", "id": "tartas", "label": "Pies y tartas: Nombre|porción|entera", "default": "Pie de limón|3000|17000, Pie de coco|3000|17000, Banoffee|3500|17000, Tarta Snickers|3000|17000, Tarta chocolate y pistacho|3500|19000, Frambuesa miga||17000"},
  {"type": "text", "id": "boton", "label": "Texto del botón", "default": "Encargar ahora"},
  {"type": "text", "id": "mensaje", "label": "Mensaje de WhatsApp (encargar)", "default": "Hola Sabor Rural, quiero encargar un kuchen o tarta para mañana."},
  {"type": "text", "id": "mensaje_variedades", "label": "Mensaje de WhatsApp (variedades)", "default": "Hola Sabor Rural, ¿qué variedades de kuchen, pies y tartas tienen para encargar?"},
  {"type": "text", "id": "whatsapp", "label": "WhatsApp (números, con código de país)", "default": "56992101764"},
  {"type": "text", "id": "carta_url", "label": "Enlace de la carta", "default": "/pages/carta"}
 ],
 "presets": [{"name": "Sabor Rural: kuchen"}]
}
{% endschema %}
