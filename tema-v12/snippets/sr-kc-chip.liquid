{%- comment -%} Botón de un sabor en "Encarga tu kuchen". Parámetros: n (nombre), vp (variante por porción, ya no se muestra), ve (variante pieza entera, el precio que se muestra) {%- endcomment -%}
<button type="button" class="kc-chip" data-n="{{ n | escape }}" data-vp="{{ vp.id }}" data-p="{{ vp.price | divided_by: 100 }}" data-ve="{{ ve.id }}" data-e="{{ ve.price | divided_by: 100 }}" aria-pressed="false"><b>{{ n }}</b><small>{%- if ve -%}Entera {% render 'sr-clp', c: ve.price %}{%- else -%}Entera: consultar{%- endif -%}</small></button>
