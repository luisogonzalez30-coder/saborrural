{%- comment -%} Una línea de la carta con su botón para agregar al pedido. Parámetro: p (producto) {%- endcomment -%}
<li class="mn-item">
  <div class="mn-line">
    <span class="mn-nm">{{ p.title }}</span>
    <i class="mn-dots" aria-hidden="true"></i>
    <span class="mn-pr">{%- if p.price_varies -%}<small>desde</small>{%- endif -%}{% render 'sr-clp', c: p.price %}</span>
  </div>
  {%- if p.description != blank -%}<span class="mn-ds">{{ p.description | strip_html | truncate: 300 }}</span>{%- endif -%}
  {%- if p.available and p.price > 0 -%}
  <div class="mn-add">
    {%- unless p.has_only_default_variant -%}
      <select class="mn-var" aria-label="Opción de {{ p.title | escape }}">
        {%- for v in p.variants -%}{%- if v.available -%}<option value="{{ v.id }}">{{ v.title }}{% if p.price_varies %} · {% render 'sr-clp', c: v.price %}{% endif %}</option>{%- endif -%}{%- endfor -%}
      </select>
    {%- endunless -%}
    <button type="button" class="mn-addb" data-vid="{{ p.selected_or_first_available_variant.id }}" aria-label="Agregar {{ p.title | escape }} al pedido">+ Agregar</button>
  </div>
  {%- elsif p.has_only_default_variant == false -%}
  <span class="mn-opt"><b>Opciones:</b> {{ p.variants | map: 'title' | join: ' · ' }}</span>
  {%- endif -%}
</li>
